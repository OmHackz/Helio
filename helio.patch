+            if (doc.RootElement.TryGetProperty("error", out var errEl))
+                return errEl.GetString();
+        }
+        catch
+        {
+            // Not JSON
+        }
+
+        return string.IsNullOrWhiteSpace(raw) ? null : raw;
+    }
